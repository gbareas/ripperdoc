{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RipperdocReview",
  "type": "object",
  "required": [
    "round",
    "slug",
    "date",
    "intake",
    "verifications",
    "verdict",
    "confidence",
    "confidence_reason",
    "issues",
    "actions",
    "insights",
    "questions",
    "previous_issues",
    "keep_or_revert",
    "stop",
    "stop_reason",
    "worklog"
  ],
  "additionalProperties": false,
  "properties": {
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "intake": {
      "type": "object",
      "required": [
        "goal",
        "claim",
        "acceptance_criteria",
        "criteria_source",
        "artifacts_missing"
      ],
      "additionalProperties": false,
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "criteria_source": {
          "enum": [
            "protocol",
            "dossier",
            "caller",
            "inferred"
          ],
          "description": "Where the acceptance criteria came from, in order of precedence: a frozen/pre-registered protocol, the dossier (project documents), the caller (the producer side, at review time), or inferred by Ripperdoc"
        },
        "criteria_ref": {
          "type": "string",
          "minLength": 1,
          "description": "The protocol file and hash, or the dossier entry/document section, that the criteria were taken from"
        },
        "artifacts_missing": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dossier_links": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "code_review_file": {
          "type": "string",
          "minLength": 1
        },
        "rerun_budget": {
          "type": "string",
          "minLength": 1,
          "description": "Only when the caller explicitly allowed rerunning the pipeline: what may be rerun and the time limit, as the caller stated it"
        }
      }
    },
    "verifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "claim",
          "method",
          "reported",
          "observed",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "trace",
              "recompute",
              "rerun"
            ],
            "description": "trace: followed the number to the code line and equation and judged them; recompute: recalculated it from saved outputs (<= 5 min, sandboxed); rerun: reran the producer pipeline, only with intake.rerun_budget"
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "reported": {
            "type": "string",
            "minLength": 1
          },
          "observed": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "confirmed",
              "contradicted",
              "could_not_verify"
            ]
          },
          "rerun_dir": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "description": "Where the number comes from: file:line and the equation or reference it implements (trace), or the saved output file used (recompute)"
          }
        }
      },
      "minItems": 1,
      "maxItems": 3
    },
    "verdict": {
      "enum": [
        "accept",
        "revise",
        "reject"
      ]
    },
    "confidence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "confidence_reason": {
      "type": "string",
      "minLength": 1
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "category",
          "what",
          "why",
          "fix",
          "question"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "blocking",
              "nice_to_have"
            ]
          },
          "category": {
            "enum": [
              "answers_ask",
              "evidence",
              "assumption",
              "edge_case",
              "contradiction",
              "falsifiability",
              "claim_strength",
              "prior_work",
              "controls",
              "baselines",
              "confound",
              "power",
              "reproducibility",
              "pre_specification",
              "statistics",
              "code_defect",
              "other"
            ]
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "what": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          },
          "fix": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "merged_from": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z]+:"
            },
            "description": "Ensemble merge only: the source issues this issue stands for, as <reviewer>:<issue id>, e.g. a:R1-02"
          }
        }
      }
    },
    "actions": {
      "type": "object",
      "required": [
        "do",
        "revise",
        "discard"
      ],
      "additionalProperties": false,
      "properties": {
        "do": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "revise": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "discard": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "code_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref",
          "affects_result",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "affects_result": {
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "issue_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "insights": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 3
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "previous_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "resolved",
              "partially_resolved",
              "unresolved",
              "regressed"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "keep_or_revert": {
      "enum": [
        "keep",
        "revert",
        "n/a"
      ]
    },
    "stop": {
      "type": "boolean"
    },
    "stop_reason": {
      "enum": [
        "no_blocking_issues",
        "round_cap",
        "no_progress",
        "continue"
      ]
    },
    "worklog": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "reviewer_disagreements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviewer": {
      "type": "string",
      "pattern": "^[a-z]+$",
      "description": "Ensemble member id (a, b, ...) when this is one of several independent reviews to be merged"
    },
    "reviewer_model": {
      "type": "string",
      "minLength": 1,
      "description": "Model that wrote this review, when known"
    },
    "ensemble_of": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Merged review only: paths (relative to this report) of the member reviews it merges"
    },
    "dismissed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^[a-z]+:(R\\d+-\\d+|V\\d+)$",
            "description": "<reviewer>:<issue id> for a blocking issue, <reviewer>:V<n> for the n-th verification (1-based)"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "description": "Why it does not stand, with what was checked"
          }
        }
      },
      "description": "Merged review only: member blocking issues or contradicted verifications that the merge did not keep"
    }
  }
}
